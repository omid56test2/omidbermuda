# Required: generate with `openssl rand -hex 32` or an equivalent secure RNG.
# Leave blank here so Compose fails closed until you set a private value.
ADMIN_TOKEN=

# Required: canonical HTTPS origin used in generated client links (no trailing slash).
PUBLIC_BASE_URL=

# Admin/Gateway host binding. Keep loopback when a reverse proxy runs on this host.
HOST_BIND=127.0.0.1
HOST_PORT=8080

# Set only to the real immediate reverse-proxy source ranges. Leave blank otherwise.
TRUSTED_PROXY_CIDRS=

XRAY_AUTOSTART=true
XRAY_AUTORESTART=true
